# Copy to .env.local for development. Never commit real values.

# App
AUTH_SECRET=                    # generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=                 # comma separated Google emails allowed to sign in

# Database
DATABASE_URL=                   # Neon pooled connection string, or postgres://ourjob:ourjob@localhost:5433/ourjob for local Docker
DATABASE_URL_UNPOOLED=          # Neon direct connection string; only for pnpm db:migrate:prod, in .env.production.local

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite  # used for everything (measured 2026-10-29, see DECISIONS.md)
LLM_FALLBACK_MODEL=gemini-3.8-flash  # tried when the main model stays busy (503) or rate limited
LLM_THOROUGH_MODEL=gemini-3.8-flash  # optional, offered in Settings for writing tailored CVs; free tier allows 20 requests a day; leave empty to hide
LLM_RPM=8                       # requests per minute to stay under; see AI Studio for your limits
LLM_DAILY_CALL_BUDGET=40

# Sources (tier 3 optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
JSEARCH_HOST=                   # rapidapi host or openwebninja base url
GITHUB_TOKEN=                   # optional, raises GitHub API limits for ingestion

# Pipeline
PIPELINE_MAX_COMPANIES=400
PIPELINE_NEW_COMPANIES_PER_RUN=50
GITHUB_DISPATCH_TOKEN=          # optional, for the Run now button
GITHUB_REPO=                    # owner/name
CRON_SECRET=                    # only for the Vercel cron fallback

# Development
ENABLE_DESIGN_TILE=             # set to 1 to serve /design in a production build
