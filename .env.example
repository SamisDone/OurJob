# Copy to .env.local for development. Never commit real values.

# App
APP_URL=                        # e.g. http://localhost:3000 or your Vercel URL
AUTH_SECRET=                    # generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=                 # comma separated Google emails allowed to sign in

# Database
DATABASE_URL=                   # Neon pooled connection string, or postgres://ourjob:ourjob@localhost:5433/ourjob for local Docker

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=                      # pick a free-tier eligible model at build time
LLM_DAILY_CALL_BUDGET=40

# Sources (tier 3 optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
JSEARCH_HOST=                   # rapidapi host or openwebninja base url
GITHUB_TOKEN=                   # optional, raises GitHub API limits for ingestion

# Pipeline
PIPELINE_MAX_COMPANIES=400
PIPELINE_NEW_COMPANIES_PER_RUN=50
GITHUB_DISPATCH_TOKEN=          # optional, for the Run now button
GITHUB_REPO=                    # owner/name
CRON_SECRET=                    # only for the Vercel cron fallback

# Development
ENABLE_DESIGN_TILE=             # set to 1 to serve /design in a production build
